      "name": "about_title",
      "value": "About this app"
    },
    {
      "name": "about_body",
      "value": "Health Sim generates deterministic, simulated wearable data in the shape of Huawei Health data (Health Service Kit sample points), so FairWear can be demonstrated on the emulator. It is not Huawei Health, it is not a Huawei app, and it never reads real health data. Reading real Huawei Health data requires Huawei to approve Health Service Kit access for the app."
    },
    {
      "name": "auth_title",
      "value": "%s wants to read your health data"
    },
    {
      "name": "auth_sub",
      "value": "Simulated data in Huawei Health format · persona %s · last %s days"
    },
    {
      "name": "auth_note",
      "value": "Data stays on this phone: the system hands it to the requesting app and nothing is sent over the network. Scenario truth (illness, watch removal) is never shared."
    },
