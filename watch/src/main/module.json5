{
  "module": {
    "name": "watch",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "WatchAbility",
    "deviceTypes": [
      "wearable"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "requestPermissions": [
      {
        "name": "ohos.permission.READ_HEALTH_DATA",
        "reason": "$string:reason_heart_rate",
        "usedScene": {
          "abilities": [
            "WatchAbility"
          ],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.ACTIVITY_MOTION",
        "reason": "$string:reason_steps",
        "usedScene": {
          "abilities": [
            "WatchAbility"
          ],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.MICROPHONE",
        "reason": "$string:reason_microphone",
        "usedScene": {
          "abilities": [
            "VisitRecordAbility"
          ],
          "when": "inuse"
        }
      }
    ],
    "abilities": [
      {
        "name": "WatchAbility",
        "srcEntry": "./ets/watchability/WatchAbility.ets",
        "description": "$string:WatchAbility_desc",
        "icon": "$media:layered_image",
        "label": "$string:WatchAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "ohos.want.action.home"
            ]
          }
        ]
      },
      {
        "name": "VisitRecordAbility",
        "srcEntry": "./ets/visitability/VisitRecordAbility.ets",
        "description": "$string:VisitRecordAbility_desc",
        "icon": "$media:layered_image",
        "label": "$string:VisitRecordAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "ohos.want.action.home"
            ]
          }
        ]
      }
    ]
  }
}
